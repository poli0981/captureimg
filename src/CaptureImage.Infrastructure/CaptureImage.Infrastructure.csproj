<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>CaptureImage.Infrastructure</RootNamespace>
    <AssemblyName>CaptureImage.Infrastructure</AssemblyName>
    <!-- CsWin32-generated P/Invoke and the WGC/WIC readback use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SHFILEOPSTRUCT has architecture-specific packing; the app ships win-x64 only. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptureImage.Core\CaptureImage.Core.csproj" />
  </ItemGroup>

</Project>
