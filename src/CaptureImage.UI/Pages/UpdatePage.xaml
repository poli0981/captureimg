<Page
    x:Class="CaptureImage.UI.Pages.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.Update;assembly=CaptureImage.ViewModels"
    Title="{loc:Tr Nav_Update}"
    d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    AutomationProperties.AutomationId="UpdatePage"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,32,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Update_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr Update_Subtitle}" />

            <ui:Card Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr Update_CurrentVersion}" />
                        <TextBlock
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="Update_CurrentVersion"
                            FontWeight="SemiBold"
                            Text="{Binding AppInfo.DisplayVersion}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        AutomationProperties.AutomationId="Update_Status"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        Height="4"
                        Margin="0,10,0,0"
                        AutomationProperties.Name="{loc:Tr Update_Progress}"
                        IsIndeterminate="{Binding IsProgressIndeterminate}"
                        Maximum="100"
                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"
                        Value="{Binding Progress}" />
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button
                            Margin="0,0,8,4"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="Update_Check"
                            Command="{Binding CheckCommand}"
                            Content="{loc:Tr Update_Check}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                        <ui:Button
                            Margin="0,0,8,4"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="Update_Download"
                            Command="{Binding DownloadCommand}"
                            Content="{loc:Tr Update_Download}"
                            Icon="{ui:SymbolIcon ArrowDownload24}"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,8,4"
                            Appearance="Success"
                            AutomationProperties.AutomationId="Update_Install"
                            Command="{Binding InstallAndRestartCommand}"
                            Content="{loc:Tr Update_Install}"
                            Icon="{ui:SymbolIcon ArrowCircleUp24}"
                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,8,4"
                            AutomationProperties.AutomationId="Update_Cancel"
                            Command="{Binding CancelCommand}"
                            Content="{loc:Tr Common_Cancel}"
                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,8,4"
                            AutomationProperties.AutomationId="Update_OpenReleases"
                            Command="{Binding OpenReleasesCommand}"
                            Content="{loc:Tr Update_OpenReleases}"
                            Icon="{ui:SymbolIcon ArrowUpRight24}" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock
                Style="{StaticResource SectionHeader}"
                Text="{loc:Tr Update_ReleaseNotes}"
                Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}" />
            <ui:Card Padding="16" Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
                <TextBox
                    MaxHeight="360"
                    AutomationProperties.AutomationId="Update_ReleaseNotes"
                    AutomationProperties.Name="{loc:Tr Update_ReleaseNotes}"
                    Background="Transparent"
                    BorderThickness="0"
                    IsReadOnly="True"
                    Text="{Binding ReleaseNotes, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </ui:Card>

            <Expander Margin="0,16,0,0" Header="{loc:Tr Update_Log}">
                <ItemsControl
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="Update_Log"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    ItemsSource="{Binding LogLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
