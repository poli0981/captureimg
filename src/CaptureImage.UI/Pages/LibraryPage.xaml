<Page
    x:Class="CaptureImage.UI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.Library;assembly=CaptureImage.ViewModels"
    Title="{loc:Tr Nav_Library}"
    d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
    ScrollViewer.CanContentScroll="False"
    AutomationProperties.AutomationId="LibraryPage"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Library_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding SummaryText}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:TextBox
                Width="260"
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Library_Search"
                AutomationProperties.Name="{loc:Tr Library_Search}"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{loc:Tr Library_Search}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                MinWidth="200"
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Library_GameFilter"
                AutomationProperties.Name="{loc:Tr Library_GameFilter}"
                ItemsSource="{Binding Games}"
                SelectedItem="{Binding SelectedGame}" />
            <CheckBox
                Margin="0,0,8,4"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="Library_HdrOnly"
                Content="{loc:Tr Library_HdrOnly}"
                IsChecked="{Binding HdrOnly}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Library_Refresh"
                AutomationProperties.Name="{loc:Tr Dashboard_Refresh}"
                Command="{Binding RefreshCommand}"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                ToolTip="{loc:Tr Dashboard_Refresh}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox
                    x:Name="Gallery"
                    AutomationProperties.AutomationId="Library_Items"
                    AutomationProperties.Name="{loc:Tr Library_Title}"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Items}"
                    MouseDoubleClick="OnItemDoubleClick"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionMode="Single"
                    VirtualizingPanel.CacheLength="2,2"
                    VirtualizingPanel.CacheLengthUnit="Page"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ui:VirtualizingWrapPanel ItemSize="232,190" SpacingMode="Uniform" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CaptureItemViewModel}">
                            <Grid Width="220">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="124" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    ClipToBounds="True"
                                    CornerRadius="6"
                                    FlowDirection="LeftToRight">
                                    <Image
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <Border
                                    Margin="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource Badge}"
                                    Visibility="{Binding HasHdr, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="HDR" />
                                </Border>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="2,6,2,0"
                                    FontWeight="Medium"
                                    Text="{Binding FileName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="2,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding CapturedAtText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ui:ProgressRing
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryText}"
                    Text="{loc:Tr Library_Empty}"
                    TextAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!--  Details of the selected capture  -->
            <ui:Card
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="12"
                VerticalAlignment="Top">
                <Grid>
                    <TextBlock
                        Style="{StaticResource SecondaryText}"
                        Text="{loc:Tr Library_SelectHint}"
                        Visibility="{Binding SelectedItem, Converter={StaticResource NoValueToVisibility}}" />
                    <StackPanel DataContext="{Binding SelectedItem}" Visibility="{Binding Converter={StaticResource HasValueToVisibility}}">
                        <Border
                            Height="170"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6"
                            FlowDirection="LeftToRight">
                            <Image
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailToImage}}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            Margin="0,10,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding FileName}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Game}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CapturedAtText}" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Dimensions}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text=" · " />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding FormatName}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text=" · " />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SizeText}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ui:Card.Footer>
                    <WrapPanel Visibility="{Binding SelectedItem, Converter={StaticResource HasValueToVisibility}}">
                        <ui:Button
                            Margin="0,0,6,6"
                            Appearance="Primary"
                            AutomationProperties.AutomationId="Library_Open"
                            Command="{Binding OpenCommand}"
                            Content="{loc:Tr Library_Open}"
                            Icon="{ui:SymbolIcon Open24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_Reveal"
                            Command="{Binding RevealCommand}"
                            Content="{loc:Tr Library_Reveal}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_OpenHdr"
                            Command="{Binding OpenHdrCommand}"
                            Content="{loc:Tr Library_OpenHdr}"
                            Icon="{ui:SymbolIcon Hdr24}"
                            Visibility="{Binding SelectedItem.HasHdr, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_CopyImage"
                            Command="{Binding CopyImageCommand}"
                            Content="{loc:Tr Common_CopyImage}"
                            Icon="{ui:SymbolIcon Copy24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_CopyPath"
                            Command="{Binding CopyPathCommand}"
                            Content="{loc:Tr Library_CopyPath}"
                            Icon="{ui:SymbolIcon Link24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_ExtractText"
                            Command="{Binding ExtractTextCommand}"
                            Content="{loc:Tr Preview_ExtractText}"
                            Icon="{ui:SymbolIcon ScanText24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            AutomationProperties.AutomationId="Library_Pin"
                            Command="{Binding PinCommand}"
                            Content="{loc:Tr Library_Pin}"
                            Icon="{ui:SymbolIcon Pin24}" />
                        <ui:Button
                            Margin="0,0,6,6"
                            Appearance="Danger"
                            AutomationProperties.AutomationId="Library_Delete"
                            Command="{Binding DeleteCommand}"
                            Content="{loc:Tr Library_Delete}"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </WrapPanel>
                </ui:Card.Footer>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
