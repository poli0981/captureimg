<Page
    x:Class="CaptureImage.UI.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:CaptureImage.Core.Models;assembly=CaptureImage.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.Logs;assembly=CaptureImage.ViewModels"
    Title="{loc:Tr Nav_Logs}"
    d:DataContext="{d:DesignInstance Type=vm:LogViewerViewModel}"
    ScrollViewer.CanContentScroll="False"
    AutomationProperties.AutomationId="LogsPage"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Logs_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr Logs_Subtitle}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox
                MinWidth="160"
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_Level"
                AutomationProperties.Name="{loc:Tr Logs_Level}"
                DisplayMemberPath="Label"
                ItemsSource="{Binding LevelOptions}"
                SelectedValue="{Binding MinimumLevel}"
                SelectedValuePath="Value" />
            <ui:TextBox
                Width="240"
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_Search"
                AutomationProperties.Name="{loc:Tr Logs_Search}"
                ClearButtonEnabled="True"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{loc:Tr Logs_Search}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            <ToggleButton
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_Pause"
                Content="{loc:Tr Log_Pause}"
                IsChecked="{Binding IsPaused}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_CopySelected"
                AutomationProperties.Name="{loc:Tr Logs_CopySelected}"
                Command="{Binding CopySelectedCommand}"
                Icon="{ui:SymbolIcon Copy24}"
                ToolTip="{loc:Tr Logs_CopySelected}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_CopyAll"
                Command="{Binding CopyAllCommand}"
                Content="{loc:Tr Logs_CopyAll}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_Clear"
                Command="{Binding ClearCommand}"
                Content="{loc:Tr Log_Clear}"
                Icon="{ui:SymbolIcon Delete24}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_OpenFolder"
                Command="{Binding OpenLogsFolderCommand}"
                Content="{loc:Tr Log_RevealFolder}"
                Icon="{ui:SymbolIcon FolderOpen24}" />
            <ui:Button
                Margin="0,0,8,4"
                AutomationProperties.AutomationId="Logs_ExportDiagnostics"
                Command="{Binding ExportDiagnosticsCommand}"
                Content="{loc:Tr Settings_ExportDiagnostics}"
                Icon="{ui:SymbolIcon Bug24}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <ListBox
                x:Name="EntryList"
                AutomationProperties.AutomationId="Logs_Entries"
                AutomationProperties.Name="{loc:Tr Logs_Title}"
                FlowDirection="LeftToRight"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="12"
                ItemsSource="{Binding Entries}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedEntry}"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:LogEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding TimestampText}" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogEntryLevel.Warning}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogEntryLevel.Error}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogEntryLevel.Fatal}">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ShortSource}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SourceContext}" />
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{Binding Exception}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Exception, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryText}"
                Text="{loc:Tr Log_EmptyState}"
                Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisibility}}" />
        </Grid>
    </Grid>
</Page>
