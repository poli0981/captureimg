<Page
    x:Class="CaptureImage.UI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.About;assembly=CaptureImage.ViewModels"
    Title="{loc:Tr Nav_About}"
    d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
    ScrollViewer.CanContentScroll="False"
    AutomationProperties.AutomationId="AboutPage"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,32,24">
            <!--  App  -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="64"
                    Height="64"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Source="pack://application:,,,/CaptureImage.UI;component/Assets/CaptureImage-64.png" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding AppName}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr About_Tagline}" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr About_VersionLabel}" />
                        <TextBlock
                            Margin="4,0,12,0"
                            AutomationProperties.AutomationId="About_Version"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding Version}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr About_LicenseLabel}" />
                        <TextBlock
                            Margin="4,0,12,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding License}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Tr About_DeveloperLabel}" />
                        <TextBlock
                            Margin="4,0,12,0"
                            Style="{StaticResource CaptionText}"
                            Text="{Binding Developer}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding Runtime}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OperatingSystem}" />
                </StackPanel>
            </Grid>

            <!--  Contact  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_ContactSection}" />
            <ui:CardControl
                Command="{Binding EmailContactCommand}"
                Icon="{ui:SymbolIcon Mail24}"
                Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr About_Email}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Contact}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="ArrowUpRight24" />
            </ui:CardControl>
            <ui:CardControl
                Command="{Binding OpenLinksPageCommand}"
                Icon="{ui:SymbolIcon Link24}"
                Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr About_OtherChannels}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding LinksPage}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="ArrowUpRight24" />
            </ui:CardControl>
            <ui:CardControl
                Command="{Binding OpenRepositoryCommand}"
                Icon="{ui:SymbolIcon Code24}"
                Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr About_RepositoryLabel}" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="github.com/poli0981/captureimg" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="ArrowUpRight24" />
            </ui:CardControl>

            <!--  Feedback  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_FeedbackSection}" />
            <WrapPanel>
                <ui:Button
                    Margin="0,0,8,8"
                    AutomationProperties.AutomationId="About_ReportBug"
                    Command="{Binding ReportBugCommand}"
                    Content="{loc:Tr About_OpenBugReport}"
                    Icon="{ui:SymbolIcon Bug24}"
                    ToolTip="{loc:Tr About_OpenBugReportHint}" />
                <ui:Button
                    Margin="0,0,8,8"
                    AutomationProperties.AutomationId="About_RequestFeature"
                    Command="{Binding RequestFeatureCommand}"
                    Content="{loc:Tr About_RequestFeature}"
                    Icon="{ui:SymbolIcon Lightbulb24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    AutomationProperties.AutomationId="About_Discussions"
                    Command="{Binding OpenDiscussionsCommand}"
                    Content="{loc:Tr About_Discussions}"
                    Icon="{ui:SymbolIcon Chat24}" />
                <ui:Button
                    Margin="0,0,8,8"
                    AutomationProperties.AutomationId="About_ReleaseNotes"
                    Command="{Binding OpenReleaseNotesCommand}"
                    Content="{loc:Tr About_ReleaseNotes}"
                    Icon="{ui:SymbolIcon History24}" />
            </WrapPanel>

            <!--  Support  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_DonateSection}" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SecondaryText}"
                Text="{loc:Tr About_DonateBody}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding SponsorLinks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SponsorLink}">
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Url}"
                            Content="{Binding Name}"
                            Icon="{ui:SymbolIcon Heart24}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button
                Margin="0,0,8,8"
                AutomationProperties.AutomationId="About_EmailSponsor"
                Command="{Binding EmailSponsorCommand}"
                Content="{loc:Tr About_SponsorEmail}"
                Icon="{ui:SymbolIcon Mail24}" />

            <!--  Legal  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_LegalSection}" />
            <WrapPanel>
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="LICENSE"
                    Content="{loc:Tr About_OpenLicense}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="docs/legal/PRIVACY.md"
                    Content="{loc:Tr About_OpenPrivacy}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="docs/legal/TERMS.md"
                    Content="{loc:Tr About_OpenTerms}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="docs/legal/DISCLAIMER.md"
                    Content="{loc:Tr About_OpenDisclaimer}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="docs/legal/THIRD_PARTY_NOTICES.md"
                    Content="{loc:Tr About_OpenThirdParty}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="NOTICE"
                    Content="{loc:Tr About_OpenNotice}" />
                <ui:Button
                    Margin="0,0,8,8"
                    Command="{Binding OpenDocumentCommand}"
                    CommandParameter="docs/CONTRIBUTORS.md"
                    Content="{loc:Tr About_OpenContributors}" />
            </WrapPanel>

            <!--  Third-party  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_ThirdPartySection}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding ThirdPartyItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThirdPartyItem}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SecondaryText}"
                                Text="{Binding License}" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource CaptionText}"
                                Text="{Binding Url}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Notices  -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_AiSection}" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="{loc:Tr About_AiNotice}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr About_DisclaimersSection}" />
            <TextBlock
                FontWeight="SemiBold"
                Text="{loc:Tr About_TranslationDisclaimer}" />
            <TextBlock
                Margin="0,2,0,10"
                Style="{StaticResource SecondaryText}"
                Text="{loc:Tr About_TranslationDisclaimerBody}" />
            <TextBlock FontWeight="SemiBold" Text="{loc:Tr About_CaptureDisclaimer}" />
            <TextBlock
                Margin="0,2,0,10"
                Style="{StaticResource SecondaryText}"
                Text="{loc:Tr About_CaptureLimitationDisclaimerBody}" />
            <TextBlock FontWeight="SemiBold" Text="{loc:Tr About_LiabilityDisclaimer}" />
            <TextBlock
                Margin="0,2,0,10"
                Style="{StaticResource SecondaryText}"
                Text="{loc:Tr About_LiabilityDisclaimerBody}" />
        </StackPanel>
    </ScrollViewer>
</Page>
