<Window
    x:Class="CaptureImage.UI.Windows.PinnedThumbnailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="340"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="PinnedThumbnail"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border
        Margin="8"
        Padding="4"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="2" />
        </Border.Effect>
        <Grid x:Name="Root" Background="Transparent">
            <Image
                x:Name="Thumbnail"
                FlowDirection="LeftToRight"
                RenderOptions.BitmapScalingMode="HighQuality"
                Stretch="Uniform" />
            <StackPanel
                x:Name="Actions"
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <ui:Button
                    x:Name="RevealButton"
                    Margin="0,0,4,0"
                    Padding="6"
                    AutomationProperties.Name="{loc:Tr PinnedWindow_Open}"
                    Click="OnRevealClick"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="{loc:Tr PinnedWindow_Open}" />
                <ui:Button
                    x:Name="CopyButton"
                    Margin="0,0,4,0"
                    Padding="6"
                    AutomationProperties.Name="{loc:Tr Common_CopyImage}"
                    Click="OnCopyClick"
                    Icon="{ui:SymbolIcon Copy24}"
                    ToolTip="{loc:Tr Common_CopyImage}" />
                <ui:Button
                    Padding="6"
                    AutomationProperties.Name="{loc:Tr PinnedWindow_Close}"
                    Click="OnCloseClick"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    ToolTip="{loc:Tr PinnedWindow_Close}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
