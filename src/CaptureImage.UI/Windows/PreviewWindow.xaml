<ui:FluentWindow
    x:Class="CaptureImage.UI.Windows.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.Preview;assembly=CaptureImage.ViewModels"
    Title="{loc:Tr Preview_Title}"
    Width="1000"
    Height="700"
    MinWidth="480"
    MinHeight="360"
    d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
    AutomationProperties.AutomationId="PreviewWindow"
    ExtendsContentIntoTitleBar="True"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding DiscardCommand}" />
        <KeyBinding
            Key="C"
            Command="{Binding CopyImageCommand}"
            Modifiers="Control" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Title="{Binding Title}"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="False" />
        <Border
            Grid.Row="1"
            Margin="16,0,16,8"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            CornerRadius="6"
            FlowDirection="LeftToRight">
            <Image
                x:Name="PreviewImage"
                Margin="4"
                AutomationProperties.Name="{Binding Title}"
                RenderOptions.BitmapScalingMode="HighQuality"
                Stretch="Uniform"
                StretchDirection="DownOnly" />
        </Border>
        <Grid Grid.Row="2" Margin="16,4,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{loc:Tr Preview_Prompt}" />
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Dimensions}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="Preview_ExtractText"
                    Command="{Binding ExtractTextCommand}"
                    Content="{loc:Tr Preview_ExtractText}"
                    Icon="{ui:SymbolIcon ScanText24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="Preview_Copy"
                    Command="{Binding CopyImageCommand}"
                    Content="{loc:Tr Common_CopyImage}"
                    Icon="{ui:SymbolIcon Copy24}" />
                <ui:Button
                    Margin="0,0,8,0"
                    AutomationProperties.AutomationId="Preview_Discard"
                    Command="{Binding DiscardCommand}"
                    Content="{loc:Tr Preview_Discard}"
                    Icon="{ui:SymbolIcon Delete24}" />
                <ui:Button
                    AutomationProperties.AutomationId="Preview_Save"
                    Appearance="Primary"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Tr Preview_Save}"
                    Icon="{ui:SymbolIcon Save24}"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
