<Window
    x:Class="CaptureImage.UI.Windows.RegionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    Title="{loc:Tr Region_Title}"
    AutomationProperties.AutomationId="RegionOverlay"
    AutomationProperties.HelpText="{loc:Tr Region_DragHint}"
    AutomationProperties.Name="{loc:Tr Region_Title}"
    Background="Black"
    Cursor="Cross"
    FlowDirection="LeftToRight"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Grid x:Name="Root">
        <Image
            x:Name="Frozen"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            Stretch="Fill" />
        <Path
            x:Name="Shade"
            Fill="#8C000000"
            IsHitTestVisible="False" />
        <Canvas IsHitTestVisible="False">
            <Rectangle
                x:Name="SelectionBorder"
                Stroke="White"
                StrokeThickness="1"
                Visibility="Collapsed" />
            <Border
                x:Name="SizeLabel"
                Padding="6,2"
                Background="#E0202020"
                CornerRadius="4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SizeText"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="White" />
            </Border>
        </Canvas>
        <Border
            x:Name="Hint"
            MaxWidth="900"
            Margin="16,32,16,0"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#E0202020"
            CornerRadius="6"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="HintText"
                FontSize="14"
                Foreground="White"
                Text="{loc:Tr Region_DragHint}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
