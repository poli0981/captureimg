<ui:FluentWindow
    x:Class="CaptureImage.UI.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CaptureImage.UI.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:CaptureImage.UI.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CaptureImage.ViewModels.Shell;assembly=CaptureImage.ViewModels"
    Title="{Binding Title}"
    Width="1100"
    Height="760"
    MinWidth="760"
    MinHeight="520"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    AutomationProperties.AutomationId="MainWindow"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/CaptureImage.UI;component/Assets/CaptureImage.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/CaptureImage.UI;component/Assets/CaptureImage-64.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <!--  A Header replaces the title text, so it shows both.  -->
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding Subtitle}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="230"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Dashboard"
                    Content="{loc:Tr Nav_Dashboard}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Library"
                    Content="{loc:Tr Nav_Library}"
                    Icon="{ui:SymbolIcon ImageMultiple24}"
                    TargetPageType="{x:Type pages:LibraryPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Profiles"
                    Content="{loc:Tr Nav_Profiles}"
                    Icon="{ui:SymbolIcon Games24}"
                    TargetPageType="{x:Type pages:ProfilesPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Settings"
                    Content="{loc:Tr Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Logs"
                    Content="{loc:Tr Nav_Logs}"
                    Icon="{ui:SymbolIcon DocumentText24}"
                    TargetPageType="{x:Type pages:LogsPage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_Update"
                    Content="{loc:Tr Nav_Update}"
                    Icon="{ui:SymbolIcon ArrowSync24}"
                    TargetPageType="{x:Type pages:UpdatePage}" />
                <ui:NavigationViewItem
                    AutomationProperties.AutomationId="Nav_About"
                    Content="{loc:Tr Nav_About}"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ui:ContentDialogHost
            x:Name="DialogHost"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
