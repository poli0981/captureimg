<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests: start the real CaptureImage.App.exe with a temporary data folder and drive
    it through UI Automation (FlaUI). They move the mouse and type, so they only run when
    CAPTUREIMAGE_UI_TESTS=1 (the ui-tests CI job); otherwise every test reports as skipped.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the app first; the tests launch its executable, they don't load it. -->
    <ProjectReference Include="..\..\src\CaptureImage.App\CaptureImage.App.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
