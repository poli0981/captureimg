# Store text as LF in the repository *and* check it out as LF, regardless of the
# local core.autocrlf setting (this dev box and GitHub's Windows runners both
# default to true). .editorconfig says end_of_line = lf and the CI `format` job
# runs `dotnet format --verify-no-changes`, which enforces it.
* text=auto eol=lf

# Windows batch files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Diff drivers.
*.cs   text diff=csharp
*.md   text diff=markdown

# Binaries — never touch.
*.dll    binary
*.exe    binary
*.pdb    binary
*.so     binary
*.dylib  binary
*.nupkg  binary
*.zip    binary
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.webp   binary
*.tif    binary
*.tiff   binary
*.jxr    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
